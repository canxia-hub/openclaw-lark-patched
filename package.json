{
  "name": "openclaw-lark-patched",
  "version": "2026.7.16-p2",
  "description": "Self-maintained fork of @larksuite/openclaw-lark with p1 compat patches (OpenClaw 2.x plugin SDK subpaths, CJS/ESM detection). Feishu/Lark channel plugin with doc/wiki/drive/task/calendar tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canxia-hub/openclaw-lark-patched.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "openclaw-lark": "bin/openclaw-lark.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "secret-contract-api.js",
    "secret-contract-api.d.ts",
    "openclaw.plugin.json",
    "bin/",
    "src/",
    "skills/",
    "LICENSE",
    "README.md",
    "MANAGED.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:tools": "node scripts/check-tools.js",
    "prepack": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "@sinclair/typebox": "0.34.49",
    "image-size": "^2.0.2",
    "undici-types": "^8.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "channel": {
      "id": "openclaw-lark",
      "label": "Feishu",
      "selectionLabel": "Lark/Feishu (飞书)",
      "docsPath": "/channels/feishu",
      "docsLabel": "feishu",
      "blurb": "飞书/Lark enterprise messaging with doc/wiki/drive/task/calendar tools.",
      "aliases": [
        "lark"
      ],
      "order": 35,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "openclaw-lark-patched",
      "localPath": "extensions/openclaw-lark",
      "defaultChoice": "npm"
    }
  }
}
